<?xml version="1.0" encoding="utf-8"?>
<!-- Pestaña "Ventilación". Generado con la estructura común: encabezado + tarjetas. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Compuerta y turbina"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ventilación"
                    android:textColor="@color/text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profileAvatarCard"
                style="@style/Widget.AeroSmart.Card"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/press_scale"
                app:cardCornerRadius="22dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Perfil"
                    android:padding="9dp"
                    android:src="@drawable/ic_profile_placeholder" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ESTADO DE LA COMPUERTA Y TURBINA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVentState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_glass_circle">

                    <ImageView
                        android:id="@+id/imgFan"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:contentDescription="Turbina"
                        android:src="@drawable/ic_fan"
                        app:tint="@color/on_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtServoStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compuerta cerrada"
                        android:textColor="@color/on_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVentSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="La turbina está detenida"
                        android:textColor="@color/white_70"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVentActions"
            style="@style/Widget.AeroSmart.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Compuerta (servo SG90)"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleVent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:checkedButton="@id/btnCloseVent"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloseVent"
                        style="@style/Widget.AeroSmart.Segmented"
                        app:icon="@drawable/ic_vent_close"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cerrar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenVent"
                        style="@style/Widget.AeroSmart.Segmented"
                        app:icon="@drawable/ic_vent_open"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Abrir" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAirflowSpeed"
            style="@style/Widget.AeroSmart.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Velocidad de la turbina"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtFanSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 %"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutAirflowBars"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="14dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <View android:id="@+id/bar1" android:layout_width="0dp" android:layout_height="10dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_bar_on" />
                    <View android:id="@+id/bar2" android:layout_width="0dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_bar_on" />
                    <View android:id="@+id/bar3" android:layout_width="0dp" android:layout_height="18dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_bar_on" />
                    <View android:id="@+id/bar4" android:layout_width="0dp" android:layout_height="23dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_bar_off" />
                    <View android:id="@+id/bar5" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/bg_bar_off" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/seekFanSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Velocidad de la turbina"
                    android:stepSize="20"
                    android:value="60"
                    android:valueFrom="20"
                    android:valueTo="100"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOperationMode"
            style="@style/Widget.AeroSmart.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo de operación"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtModeHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Al abrir o cerrar a mano, pasa a Manual."
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleOpMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:checkedButton="@id/btnModeAuto"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeAuto"
                        style="@style/Widget.AeroSmart.Segmented"
                        app:icon="@drawable/ic_robot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Automático" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeManual"
                        style="@style/Widget.AeroSmart.Segmented"
                        app:icon="@drawable/ic_hand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Manual" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
