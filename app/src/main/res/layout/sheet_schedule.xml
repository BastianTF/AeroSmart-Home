<?xml version="1.0" encoding="utf-8"?>
<!-- Panel inferior para elegir el horario del modo automático -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Tirador del panel -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Programación horaria"
        android:textColor="@color/text_dark"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="El modo automático solo ventila dentro de este horario."
        android:textColor="@color/text_gray"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cardStartTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_time_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="14dp"
            android:stateListAnimator="@animator/press_scale">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INICIO"
                android:textColor="@color/primary_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00"
                android:textColor="@color/text_dark"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardEndTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_time_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="14dp"
            android:stateListAnimator="@animator/press_scale">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TÉRMINO"
                android:textColor="@color/primary_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEndTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22:00"
                android:textColor="@color/text_dark"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Atajos"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:chipSpacingHorizontal="8dp">

        <com.google.android.material.chip.Chip android:id="@+id/chipPresetOffice" style="@style/Widget.AeroSmart.PresetChip" android:text="Oficina 08–18" />
        <com.google.android.material.chip.Chip android:id="@+id/chipPresetNight" style="@style/Widget.AeroSmart.PresetChip" android:text="Noche 22–06" />
        <com.google.android.material.chip.Chip android:id="@+id/chipPresetAllDay" style="@style/Widget.AeroSmart.PresetChip" android:text="Todo el día" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Días"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:chipSpacingHorizontal="6dp">

        <com.google.android.material.chip.Chip android:id="@+id/chipDay1" style="@style/Widget.AeroSmart.DayChip" android:text="L" android:checked="true" />
        <com.google.android.material.chip.Chip android:id="@+id/chipDay2" style="@style/Widget.AeroSmart.DayChip" android:text="M" android:checked="true" />
        <com.google.android.material.chip.Chip android:id="@+id/chipDay3" style="@style/Widget.AeroSmart.DayChip" android:text="X" android:checked="true" />
        <com.google.android.material.chip.Chip android:id="@+id/chipDay4" style="@style/Widget.AeroSmart.DayChip" android:text="J" android:checked="true" />
        <com.google.android.material.chip.Chip android:id="@+id/chipDay5" style="@style/Widget.AeroSmart.DayChip" android:text="V" android:checked="true" />
        <com.google.android.material.chip.Chip android:id="@+id/chipDay6" style="@style/Widget.AeroSmart.DayChip" android:text="S" android:checked="true" />
        <com.google.android.material.chip.Chip android:id="@+id/chipDay7" style="@style/Widget.AeroSmart.DayChip" android:text="D" android:checked="true" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/txtScheduleError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Elige al menos un día."
        android:textColor="@color/alert_red"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSchedule"
        style="@style/Widget.AeroSmart.Button"
        app:icon="@drawable/ic_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Guardar horario" />
</LinearLayout>
