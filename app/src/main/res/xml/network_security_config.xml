<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ISO 27400: Enforce HTTPS / TLS and disallow cleartext HTTP -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
