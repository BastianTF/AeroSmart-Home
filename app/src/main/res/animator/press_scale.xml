<?xml version="1.0" encoding="utf-8"?>
<!-- Al presionar, el botón o tarjeta se achica un poco (4 %) y vuelve al soltar -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.96" android:duration="90" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.96" android:duration="90" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="160" android:interpolator="@android:interpolator/overshoot" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="160" android:interpolator="@android:interpolator/overshoot" android:valueType="floatType" />
        </set>
    </item>
</selector>
